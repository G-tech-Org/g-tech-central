# ─── G-Tech Environment Variables ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Base URL for the G-Tech backend API
VITE_API_BASE_URL=https://api.g-tech.cm

# Public form submission key used by Web3Forms
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# App title shown in <head>
VITE_APP_TITLE=G-Tech Digital Studio Platform
